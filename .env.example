# Optional: override the Web3Forms access key used by the contact form.
# The form works out of the box without this — it's only needed if the
# access key ever needs to be rotated without a code change.
# Must use the NEXT_PUBLIC_ prefix: Web3Forms requires the request to be
# made from the browser, so this value has to be readable client-side.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional: the site's real production domain, used for sitemap.xml,
# robots.txt, and social share (Open Graph/Twitter) links. Defaults to
# the Vercel preview domain if not set.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
